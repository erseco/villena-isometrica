{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://villena-isometrica.invalid/schemas/render-manifest.schema.json",
  "title": "Render manifest (renderer output, tile-export input). Layer semantics: docs/contracts/render.md",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version MAJOR.MINOR. Consumers reject an unknown MAJOR and ignore nothing: MINOR bumps only add optional fields."
    },
    "cityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "height",
        "width"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headingDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "pitchDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "pixelsPerMetre": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "E0": {
              "type": "number"
            },
            "N0": {
              "type": "number"
            },
            "H0": {
              "type": "number"
            }
          },
          "required": [
            "E0",
            "H0",
            "N0"
          ],
          "description": "Local-frame origin, see docs/contracts/projection.md section 1."
        },
        "matrix": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3
            }
          ],
          "items": false,
          "minItems": 2
        },
        "translation": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        }
      },
      "required": [
        "headingDeg",
        "matrix",
        "origin",
        "pitchDeg",
        "pixelsPerMetre",
        "translation"
      ],
      "description": "docs/contracts/projection.md section 3. matrix/translation are authoritative for consumers."
    },
    "zRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zMin": {
          "type": "number"
        },
        "zMax": {
          "type": "number"
        }
      },
      "required": [
        "zMax",
        "zMin"
      ],
      "description": "Local z extent of the render prism (metres relative to H0)."
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "color",
              "depth",
              "buildingId",
              "class"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/{}-]+$",
            "description": "Relative POSIX path, no '..', resolved against the directory of this file."
          },
          "encoding": {
            "enum": [
              "rgba8-png",
              "gray16-png",
              "rgb24-id-png",
              "index8-png"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scale": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "index": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/{}-]+$",
            "description": "Relative POSIX path, no '..', resolved against the directory of this file."
          }
        },
        "required": [
          "name",
          "path",
          "encoding",
          "sha256"
        ]
      },
      "contains": {
        "type": "object",
        "properties": {
          "name": {
            "const": "color"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "sceneSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ]
    }
  },
  "required": [
    "background",
    "cityId",
    "image",
    "layers",
    "projection",
    "renderer",
    "sceneSha256",
    "schemaVersion",
    "zRange"
  ]
}
