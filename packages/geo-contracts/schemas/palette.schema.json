{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://villena-isometrica.invalid/schemas/palette.schema.json",
  "title": "Render palette (renderer output, referenced by the render manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "colors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version MAJOR.MINOR. Consumers reject an unknown MAJOR and ignore nothing: MINOR bumps only add optional fields."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hex",
          "role"
        ],
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "What the colour is for, e.g. wall-lit, roof-tile-shade, road, outline."
          }
        }
      }
    }
  }
}
