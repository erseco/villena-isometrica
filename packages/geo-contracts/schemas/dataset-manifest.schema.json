{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://villena-isometrica.invalid/schemas/dataset-manifest.schema.json",
  "title": "Dataset manifest (cities/<id>/datasets.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version MAJOR.MINOR. Consumers reject an unknown MAJOR and ignore nothing: MINOR bumps only add optional fields."
    },
    "cityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "acquisitionDate": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "access": {
            "enum": [
              "direct",
              "ogc-service",
              "manual"
            ],
            "description": "manual = needs an interactive browser session; the acquisition script must then verify a user-provided file by checksum."
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "crs": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "attribution",
              "name",
              "url"
            ]
          },
          "redistribution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "raw": {
                "type": "boolean"
              },
              "derivatives": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "raw",
              "derivatives"
            ]
          },
          "sizeBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "null until the file has been retrieved and pinned (then sha256 of the file exactly as received). The pipeline refuses to read a local file whose checksum is null or does not match. For live services the checksum is that of the saved response."
          },
          "localPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/{}-]+$",
            "description": "Relative POSIX path, no '..', resolved against the directory of this file."
          },
          "retrievedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "access",
          "acquisitionDate",
          "coverage",
          "crs",
          "id",
          "license",
          "localPath",
          "name",
          "provider",
          "redistribution",
          "resolution",
          "retrievedAt",
          "sha256",
          "sizeBytes",
          "url",
          "version"
        ]
      }
    }
  },
  "required": [
    "cityId",
    "datasets",
    "schemaVersion"
  ]
}
